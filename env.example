# Local processor mode
APP_MODE=local

# --------------------------------------------------
# ACTIVE CONFIGURATION
# Uncomment ONE provider block below and fill in the key/model.
# Keep all other provider blocks commented out.
# --------------------------------------------------

# =========================
# Google Gemini
# =========================
# LLM_PROVIDER=gemini
# LLM_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-3.5-flash-lite

# =========================
# OpenAI
# =========================
# LLM_PROVIDER=openai
# LLM_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-5.6

# =========================
# Groq
# =========================
# LLM_PROVIDER=groq
# LLM_API_KEY=your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# =========================
# Together AI
# =========================
# LLM_PROVIDER=together
# LLM_API_KEY=your_together_api_key_here
# LLM_MODEL=your_together_model_name_here

# =========================
# Anthropic
# =========================
# LLM_PROVIDER=anthropic
# LLM_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=your_anthropic_model_name_here

# =========================
# Generic OpenAI-compatible provider
# =========================
# Use this when the service exposes an OpenAI-compatible API endpoint.
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=your_provider_api_key_here
# LLM_MODEL=your_model_name_here
# LLM_BASE_URL=https://your-provider.example/v1

# --------------------------------------------------
# Example: Gemini active
# --------------------------------------------------
# LLM_PROVIDER=gemini
# LLM_API_KEY=YOUR_REAL_KEY
# LLM_MODEL=gemini-3.5-flash-lite
